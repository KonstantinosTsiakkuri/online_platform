# Скопируйте файл в .env и подставьте свои значения
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Stripe (тестовый ключ из Dashboard -> Developers -> API keys, режим Test mode)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_CURRENCY=rub
# После оплаты Stripe вернёт пользователя на эти адреса ({CHECKOUT_SESSION_ID} подставит сам Stripe)
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/api/docs/?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://127.0.0.1:8000/api/docs/?payment=cancel

# Redis (брокер и хранилище результатов Celery) -> redis://REDIS_HOST:REDIS_PORT/REDIS_DB
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Необязательно: полный адрес вместо трёх переменных выше
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Почта (SMTP). Если EMAIL_HOST пустой — письма печатаются в консоль worker'а
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=your_mailbox@yandex.ru
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=your_mailbox@yandex.ru
